{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anilife-diagnostics",
  "main": "./cloudflare/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "diagnostics.anilifecommunity.org",
      "zone_id": "2a0a6f585a3e7013e87139a5609e6670",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "HF_NAMESPACE": "anilifecommunity",
    "HF_BUCKET": "anilife-storage",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF2gLAMDwgKOrVA2",
    "TURNSTILE_HOSTNAME": "diagnostics.anilifecommunity.org"
  },
  "secrets": {
    "required": [
      "HF_S3_ACCESS_KEY_ID",
      "HF_S3_SECRET_ACCESS_KEY",
      "ADMIN_ACCESS_KEY",
      "RATE_LIMIT_SECRET",
      "TURNSTILE_SECRET"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/v1/*", "/api/*"]
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
